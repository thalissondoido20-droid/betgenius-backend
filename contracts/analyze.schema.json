{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betgenius.app/contracts/analyze.schema.json",
  "title": "BetGenius Analyze Contract",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "required": ["league", "home_team", "away_team"],
      "properties": {
        "league": { "type": "string" },
        "home_team": { "type": "string" },
        "away_team": { "type": "string" },
        "market": { "type": "string" }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["meta", "metrics"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["request_id", "timestamp_utc", "model_version"],
          "properties": {
            "request_id": { "type": "string" },
            "timestamp_utc": { "type": "string" },
            "model_version": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "goal_expectancy_index": { "type": "number" },
            "probability_over_2_goals": { "type": "number" },
            "statistical_divergence": { "type": "number" },
            "confidence_score": { "type": "number" }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
